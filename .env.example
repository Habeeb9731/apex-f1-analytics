# Copy to .env. Keep this file private and never commit it.
# Create a GitHub OAuth App. Local callback URL:
# http://127.0.0.1:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Production access is invite-only: add comma-separated numeric GitHub user IDs.
# On local development, an empty allowlist allows any GitHub account to sign in.
GITHUB_ALLOWED_IDS=
# Comma-separated numeric GitHub user IDs to grant the admin daily quota.
GITHUB_ADMIN_IDS=
CHAT_DAILY_LIMIT=10
CHAT_ADMIN_DAILY_LIMIT=100

# OpenAI is called only by the backend. The key is never sent to the browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Local defaults. For deployment, set APP_ORIGIN to the public HTTPS origin,
# e.g. https://f1.example.com, and SQLITE_PATH to a persistent data volume.
APP_ORIGIN=http://127.0.0.1:5173
PORT=3001
VITE_PORT=5173
# SQLITE_PATH=/path/to/persistent/apex.sqlite
