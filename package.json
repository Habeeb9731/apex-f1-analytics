    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "d3": "^7.9.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "framer-motion": "^12.23.24",
    "jose": "^6.2.14",
    "lucide-react": "^0.468.0",
    "openai": "^7.45.1",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
